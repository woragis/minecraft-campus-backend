# Copy to .env before docker compose up.
# Profile: dev | budget (default, cheap) | production

CAMPUSWORLD_PROFILE=budget

POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campusworld

HTTP_ADDR=:8080
PLUGIN_API_KEY=dev-plugin-key
PROBATION_DAYS=7

BOOTSTRAP_MINECRAFT_UUID=
BOOTSTRAP_USERNAME=Fundador

MIGRATIONS_DIR=
SKIP_SQL_MIGRATIONS=0

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=1
RATE_LIMIT_ENABLED=0
METRICS_ENABLED=0
REDIS_ENABLED=0

# ── Fase 5: Worker (off by default in budget) ─────────────────
WORKER_ENABLED=0

# Backups — no AWS required when BACKUP_STORAGE=none or local
BACKUP_ENABLED=0
BACKUP_DATABASE_ENABLED=0
BACKUP_WORLD_ENABLED=0
BACKUP_STORAGE=none
BACKUP_LOCAL_PATH=/var/backups/campusworld
BACKUP_DATABASE_RETENTION_DAYS=7
BACKUP_DAILY_ENABLED=0
BACKUP_WEEKLY_ENABLED=0
BACKUP_MONTHLY_ENABLED=0

# Cheap local backup example (enable worker + these):
# WORKER_ENABLED=1
# BACKUP_ENABLED=1
# BACKUP_DATABASE_ENABLED=1
# BACKUP_STORAGE=local
# BACKUP_DAILY_ENABLED=1

METRICS_REFRESH_ENABLED=0
METRICS_REFRESH_INTERVAL_MINUTES=60
ALERTS_ENABLED=0
ALERTS_INTERVAL_MINUTES=15
ALERTS_GRIEFING_THRESHOLD_HOUR=150
ALERTS_DISCORD_WEBHOOK=

AUDIT_INGEST_ENABLED=1
AUDIT_RETENTION_DAYS=30
AUDIT_PURGE_ENABLED=1
AUDIT_PURGE_INTERVAL_HOURS=24

# Local dev (host → container via docker-compose.dev.yml):
# DATABASE_URL=postgres://campus:campus@127.0.0.1:15432/campusworld?sslmode=disable
